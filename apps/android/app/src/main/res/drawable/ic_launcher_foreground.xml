<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — fanned 3-colour deck + clapperboard.

  Design space: 280×280 viewport (maps to the 108dp physical size).
  The adaptive safe zone in this viewport is ~47–233 on each axis.
  Deck bounding box ≈ x:62–212, y:52–228 — comfortably within the safe zone.

  Fan pivot: (150, 230) — all card rotations share this anchor point.
  Cards (front→back): crimson #EA5043 at -5°, amber #F4A93C at +4°, teal #2BBBA6 at +11°.
  Clapperboard (ink #1A1410 / cream #FBF4E9) sits on the front (crimson) card.

  VectorDrawable does not support feDropShadow — depth comes from card overlap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="280"
    android:viewportHeight="280">

    <!-- Outer scale-down — shrinks deck into adaptive safe zone. -->
    <!-- Safe zone ≈ 47–233px on each axis (72/108 of the 280 viewport).    -->
    <!-- 0.82× centered at the viewport midpoint keeps all corners inside.   -->
    <group
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:pivotX="140"
        android:pivotY="140">

    <!-- ── Teal card (back) — rotate 11° ─────────────────────────────── -->
    <group
        android:pivotX="150"
        android:pivotY="230"
        android:rotation="11">
        <path
            android:fillColor="#2BBBA6"
            android:pathData="
                M120,70 H182 A28,28,0,0,1,210,98
                V200 A28,28,0,0,1,182,228
                H120 A28,28,0,0,1,92,200
                V98 A28,28,0,0,1,120,70 Z"/>
    </group>

    <!-- ── Amber card (mid) — rotate 4° ──────────────────────────────── -->
    <group
        android:pivotX="150"
        android:pivotY="230"
        android:rotation="4">
        <path
            android:fillColor="#F4A93C"
            android:pathData="
                M112,64 H174 A28,28,0,0,1,202,92
                V194 A28,28,0,0,1,174,222
                H112 A28,28,0,0,1,84,194
                V92 A28,28,0,0,1,112,64 Z"/>
    </group>

    <!-- ── Crimson card (front) + clapperboard — rotate -5° ─────────── -->
    <group
        android:pivotX="150"
        android:pivotY="230"
        android:rotation="-5">

        <!-- Front card -->
        <path
            android:fillColor="#EA5043"
            android:pathData="
                M104,58 H166 A28,28,0,0,1,194,86
                V188 A28,28,0,0,1,166,216
                H104 A28,28,0,0,1,76,188
                V86 A28,28,0,0,1,104,58 Z"/>

        <!-- Clapperboard body (ink) -->
        <path
            android:fillColor="#1A1410"
            android:pathData="
                M103,104 H167 A8,8,0,0,1,175,112
                V148 A8,8,0,0,1,167,156
                H103 A8,8,0,0,1,95,148
                V112 A8,8,0,0,1,103,104 Z"/>

        <!-- Clapperboard arm (ink) -->
        <path
            android:fillColor="#1A1410"
            android:pathData="
                M99,83 H171 A4,4,0,0,1,175,87
                V99 A4,4,0,0,1,171,103
                H99 A4,4,0,0,1,95,99
                V87 A4,4,0,0,1,99,83 Z"/>

        <!-- Diagonal stripes — clipped to arm bounds -->
        <group>
            <clip-path android:pathData="M95,83 h80 v20 h-80 Z"/>
            <path
                android:fillColor="#FBF4E9"
                android:pathData="
                    M104,83 L117,83 L109,103 L96,103 Z
                    M121,83 L134,83 L126,103 L113,103 Z
                    M138,83 L151,83 L143,103 L130,103 Z
                    M155,83 L168,83 L160,103 L147,103 Z
                    M172,83 L185,83 L177,103 L164,103 Z"/>
        </group>

        <!-- Body lines (cream, slightly translucent) -->
        <path
            android:fillColor="#FBF4E9"
            android:fillAlpha="0.85"
            android:pathData="
                M110,119 H158 A3,3,0,0,1,161,122 A3,3,0,0,1,158,125 H110 A3,3,0,0,1,107,122 A3,3,0,0,1,110,119 Z
                M110,133 H142 A3,3,0,0,1,145,136 A3,3,0,0,1,142,139 H110 A3,3,0,0,1,107,136 A3,3,0,0,1,110,133 Z"/>

    </group>

    </group> <!-- /outer scale -->
</vector>
