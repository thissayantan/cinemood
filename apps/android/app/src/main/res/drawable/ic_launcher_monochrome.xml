<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ themed-icon monochrome layer.
  System applies a single wallpaper-derived tint over the whole layer.

  White fills = visible shape; evenOdd fill on the front card punches a
  transparent hole where the clapperboard body sits, so the film element
  is readable through contrast alone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="280"
    android:viewportHeight="280">

    <!-- Outer scale-down — matches foreground layer exactly. -->
    <group
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:pivotX="140"
        android:pivotY="140">

    <!-- Teal card (back) -->
    <group android:pivotX="150" android:pivotY="230" android:rotation="11">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="
                M120,70 H182 A28,28,0,0,1,210,98
                V200 A28,28,0,0,1,182,228
                H120 A28,28,0,0,1,92,200
                V98 A28,28,0,0,1,120,70 Z"/>
    </group>

    <!-- Amber card (mid) -->
    <group android:pivotX="150" android:pivotY="230" android:rotation="4">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="
                M112,64 H174 A28,28,0,0,1,202,92
                V194 A28,28,0,0,1,174,222
                H112 A28,28,0,0,1,84,194
                V92 A28,28,0,0,1,112,64 Z"/>
    </group>

    <!-- Crimson card (front) with clapperboard body knocked out (evenOdd) -->
    <group android:pivotX="150" android:pivotY="230" android:rotation="-5">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="
                M104,58 H166 A28,28,0,0,1,194,86
                V188 A28,28,0,0,1,166,216
                H104 A28,28,0,0,1,76,188
                V86 A28,28,0,0,1,104,58 Z
                M103,83 H171 A4,4,0,0,1,175,87
                V148 A8,8,0,0,1,167,156
                H103 A8,8,0,0,1,95,148
                V87 A4,4,0,0,1,99,83
                A4,4,0,0,1,103,83 Z"/>
    </group>

    </group> <!-- /outer scale -->
</vector>
