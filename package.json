{
  "name": "cinemood",
  "private": true,
  "version": "0.0.1",
  "description": "Movies and series, found by mood.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta --kill-others-on-fail \"bun --filter @cinemood/api dev\" \"bun --filter @cinemood/web dev\"",
    "dev:api": "bun --filter @cinemood/api dev",
    "dev:web": "bun --filter @cinemood/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "deploy": "bun run --filter @cinemood/web build && bunx wrangler --cwd apps/api deploy --env production",
    "reset:data": "bash apps/api/scripts/reset-data.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
