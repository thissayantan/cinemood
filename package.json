{
  "name": "cinemood",
  "private": true,
  "version": "0.0.1",
  "description": "Movies and series, found by mood.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":        "turbo run dev --filter=@cinemood/api --filter=@cinemood/web",
    "dev:remote": "turbo run dev:remote --filter=@cinemood/api --filter=@cinemood/web",
    "dev:api":    "turbo run dev --filter=@cinemood/api",
    "dev:web":    "turbo run dev --filter=@cinemood/web",
    "build":      "turbo run build",
    "typecheck":  "turbo run typecheck",
    "deploy":     "turbo run build --filter=@cinemood/web && bunx wrangler --cwd apps/api deploy --env production",
    "reset:data": "bash apps/api/scripts/reset-data.sh"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.7.2"
  }
}
